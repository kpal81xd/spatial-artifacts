{
    "name": "spatial-artifacts",
    "private": true,
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "dev": "bun scripts/dev.ts",
        "lint": "bun run --cwd plugins/spatial-artifacts lint",
        "lint-fix": "bun run --cwd plugins/spatial-artifacts lint-fix",
        "test": "bun run --cwd plugins/spatial-artifacts test",
