{
    "name": "spatial-artifacts-plugin",
    "private": true,
    "type": "module",
    "description": "zero runtime dependencies; node runs the .ts sources directly",
    "scripts": {
        "daemon": "node server/daemon.ts",
        "lint": "prettier --check . && eslint . && tsc --project ./tsconfig.json && tsc --project ./tsconfig.dev.json && tsc --project ./tsconfig.src.json",
        "lint-fix": "prettier --write . && eslint --fix ."
    },
    "engines": {
        "node": ">=22.18"
    }
}
